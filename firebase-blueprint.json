{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "birthDate": { "type": "string" },
        "height": { "type": "number" },
        "currentWeight": { "type": "number" },
        "targetWeight": { "type": "number" },
        "goal": { "type": "string", "enum": ["hypertrophy", "weight_loss", "maintenance", "conditioning"] },
        "experienceLevel": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
        "workoutDaysAvailable": { "type": "number" },
        "foodPreferences": { "type": "string" },
        "physicalRestrictions": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "name", "email"]
    },
    "WorkoutTemplate": {
      "title": "WorkoutTemplate",
      "description": "Predefined workout routine template (e.g., Treino A, Treino B)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "muscleGroup": { "type": "string" },
        "description": { "type": "string" },
        "exerciseIds": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "name", "muscleGroup"]
    },
    "Exercise": {
      "title": "Exercise",
      "description": "Exercise details including sets, reps, weight, and rest time",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "muscleGroup": { "type": "string" },
        "equipment": { "type": "string" },
        "targetSets": { "type": "number" },
        "targetReps": { "type": "number" },
        "targetWeightKg": { "type": "number" },
        "restTimeSeconds": { "type": "number" },
        "notes": { "type": "string" },
        "videoUrl": { "type": "string" },
        "isCustom": { "type": "boolean" },
        "workoutTemplateId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "name", "muscleGroup"]
    },
    "WorkoutSchedule": {
      "title": "WorkoutSchedule",
      "description": "Calendar scheduled workout instances generated by batch or manual",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "workoutTemplateId": { "type": "string" },
        "workoutName": { "type": "string" },
        "muscleGroup": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "partial", "rest", "skipped"] },
        "cycleBatchId": { "type": "string" },
        "completedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "date", "status"]
    },
    "WorkoutSession": {
      "title": "WorkoutSession",
      "description": "Executed workout session with timing and aggregated performance metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "scheduleId": { "type": "string" },
        "workoutTemplateId": { "type": "string" },
        "workoutName": { "type": "string" },
        "date": { "type": "string" },
        "startedAt": { "type": "string" },
        "endedAt": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "totalVolumeKg": { "type": "number" },
        "totalSets": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "in_progress", "cancelled"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "date", "status"]
    },
    "ExerciseSet": {
      "title": "ExerciseSet",
      "description": "Individual set performance record with exact weight and reps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "exerciseId": { "type": "string" },
        "exerciseName": { "type": "string" },
        "setNumber": { "type": "number" },
        "targetReps": { "type": "number" },
        "actualReps": { "type": "number" },
        "targetWeightKg": { "type": "number" },
        "actualWeightKg": { "type": "number" },
        "completed": { "type": "boolean" },
        "restTimeSeconds": { "type": "number" },
        "completedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "exerciseName", "setNumber", "actualReps", "actualWeightKg"]
    },
    "NutritionEntry": {
      "title": "NutritionEntry",
      "description": "Single recorded food consumption item in daily food diary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "mealType": { "type": "string", "enum": ["breakfast", "lunch", "snack", "dinner", "custom"] },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fats": { "type": "number" },
        "fiber": { "type": "number" },
        "source": { "type": "string" },
        "verified": { "type": "boolean" },
        "sourceUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "date", "mealType", "name", "calories", "protein", "carbs", "fats"]
    },
    "FoodItem": {
      "title": "FoodItem",
      "description": "User saved food item or favorite ingredient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "defaultServing": { "type": "number" },
        "unit": { "type": "string" },
        "caloriesPer100": { "type": "number" },
        "proteinPer100": { "type": "number" },
        "carbsPer100": { "type": "number" },
        "fatsPer100": { "type": "number" },
        "fiberPer100": { "type": "number" },
        "source": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "name", "caloriesPer100", "proteinPer100", "carbsPer100", "fatsPer100"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "Custom multi-ingredient recipe with automatic nutrient recalculation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "portions": { "type": "number" },
        "ingredients": { "type": "array" },
        "totalCalories": { "type": "number" },
        "totalProtein": { "type": "number" },
        "totalCarbs": { "type": "number" },
        "totalFats": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "name", "portions", "totalCalories"]
    },
    "BodyMeasurement": {
      "title": "BodyMeasurement",
      "description": "Body weight and progress tracking entries over time",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "weightKg": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "date", "weightKg"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Configurable user goals, rest timer audio, vibration, water tracker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "calorieGoal": { "type": "number" },
        "proteinGoal": { "type": "number" },
        "carbsGoal": { "type": "number" },
        "fatsGoal": { "type": "number" },
        "waterGoalMl": { "type": "number" },
        "waterConsumedMl": { "type": "number" },
        "autoRestTimer": { "type": "boolean" },
        "defaultRestSeconds": { "type": "number" },
        "timerSound": { "type": "string", "enum": ["beep", "bell", "digital", "chime"] },
        "vibrationEnabled": { "type": "boolean" },
        "soundMuted": { "type": "boolean" },
        "notificationsEnabled": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/workoutTemplates/{templateId}": {
      "schema": "WorkoutTemplate",
      "description": "Workout routine templates"
    },
    "/exercises/{exerciseId}": {
      "schema": "Exercise",
      "description": "Exercises library"
    },
    "/workoutSchedules/{scheduleId}": {
      "schema": "WorkoutSchedule",
      "description": "Scheduled workouts on user calendar"
    },
    "/workoutSessions/{sessionId}": {
      "schema": "WorkoutSession",
      "description": "Live and completed workout session records"
    },
    "/exerciseSets/{setId}": {
      "schema": "ExerciseSet",
      "description": "Individual completed sets with weights and reps"
    },
    "/nutritionEntries/{entryId}": {
      "schema": "NutritionEntry",
      "description": "Daily food log items"
    },
    "/foodItems/{foodId}": {
      "schema": "FoodItem",
      "description": "Saved foods and ingredients"
    },
    "/recipes/{recipeId}": {
      "schema": "Recipe",
      "description": "Custom recipes"
    },
    "/bodyMeasurements/{measurementId}": {
      "schema": "BodyMeasurement",
      "description": "Body weight log history"
    },
    "/userSettings/{settingsId}": {
      "schema": "UserSettings",
      "description": "User goals and preferences"
    }
  }
}
